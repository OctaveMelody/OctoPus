{
  "name": "octopus-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdfjs-assets.mjs && node scripts/prepare-user-manual.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/prepare-pdfjs-assets.mjs && node scripts/prepare-user-manual.mjs && tsc --noEmit && vite build",
    "build:desktop": "npm run build -- --mode desktop && node scripts/build-desktop-engine.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "codemirror": "^6.0.2",
    "pdfjs-dist": "5.5.207",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
